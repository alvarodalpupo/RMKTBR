
{
  "name": "site_customization",
  "options": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["section", "key", "value", "type", "createdAt", "updatedAt"],
        "properties": {
          "section": {
            "bsonType": "string",
            "enum": ["visual", "content", "layout", "social", "seo", "advanced"],
            "description": "Seção de configuração"
          },
          "key": {
            "bsonType": "string",
            "description": "Chave única da configuração"
          },
          "value": {
            "bsonType": "string",
            "description": "Valor da configuração em JSON"
          },
          "type": {
            "bsonType": "string",
            "enum": ["color", "image", "text", "boolean", "number", "object"],
            "description": "Tipo do valor"
          },
          "label": {
            "bsonType": "string",
            "description": "Label amigável"
          },
          "description": {
            "bsonType": "string",
            "description": "Descrição da configuração"
          },
          "category": {
            "bsonType": "string",
            "description": "Categoria específica dentro da seção"
          },
          "order": {
            "bsonType": "int",
            "minimum": 0,
            "description": "Ordem de exibição"
          },
          "active": {
            "bsonType": "bool",
            "description": "Se a configuração está ativa"
          },
          "creator": {
            "bsonType": "string",
            "description": "Usuário que criou"
          },
          "createdAt": {
            "bsonType": "string",
            "title": "datetime",
            "description": "Data de criação"
          },
          "updatedAt": {
            "bsonType": "string",
            "title": "datetime",
            "description": "Data de atualização"
          }
        },
        "additionalProperties": true
      }
    },
    "validationLevel": "moderate",
    "validationAction": "warn"
  }
}
